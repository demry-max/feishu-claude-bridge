# ============ 必填（npm run register 扫码后自动写入）============
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============ owner 身份 ============
# owner 的 open_id。强烈建议设置：即使 data/owner.json 丢失/损坏，
# 你也不会被降级成访客，更不会被别人抢走 owner 身份。
# 值可在首次对话的日志里看到，或从 data/owner.json 复制。
OWNER_OPEN_ID=

# owner 记录缺失时是否允许「首个私聊者自动认领」。默认关闭——
# 盘故障或误删后，下一个私聊机器人的人会继承你的全部权限。
# 仅在初次安装且未设 OWNER_OPEN_ID 时临时设为 true。
# ALLOW_OWNER_CLAIM=

# ============ 访问控制（留空=不限制）============
ALLOW_USERS=            # 可使用机器人的 open_id，逗号分隔。注意：这不代表可以当 owner
ALLOW_CHATS=            # 群白名单 chat_id，逗号分隔

# ============ 安全（除非清楚后果，否则不要改）============
# 访客（非 owner）可用的内置工具白名单。默认只给 WebSearch。
# 加 WebFetch 意味着访客可请求任意 URL，包括 127.0.0.1 与内网地址
# （可用于探测本机端口，也可把数据编码进 URL 外传）。
# GUEST_TOOLS=WebSearch
# GUEST_WORKSPACE_DIR=  # 访客工作区，默认 ./workspace-guest；必须与 owner 工作区分离
# 注：无论这些怎么配，Bash/Write/SendMessage/Artifact 等高危工具对访客永远不可用（代码内硬下限）

# ============ claude CLI ============
CLAUDE_MODEL=           # 聊天/规划模型。留空=CLI 默认；可填 fable(=5.1)/fable5/opus/sonnet/haiku 或完整模型名
                        # fable 指向 claude-fable-5-1，需要 CLI >= 2.1.251
CLAUDE_EFFORT=          # low/medium/high/xhigh/max，留空=CLI 默认
# 模型分工：执行用便宜/快的模型，聊天规划用旗舰。留空=不分工。
# 触发执行车道：消息以 /do /exec /run 开头，或句首是「执行」「去做」「动手」「go」「do it」等
# （EXEC_TRIGGERS 可整体覆盖，逗号分隔）。定时任务默认走执行车道。/model exec <模型|off> 可随时改。
# CLAUDE_EXEC_MODEL=sonnet
# CLAUDE_EXEC_EFFORT=            # 执行车道思考档，留空沿用 CLAUDE_EFFORT
# EXEC_TRIGGERS=

# owner 可用的内置工具（默认值见下）。写权限规则必须用 Edit(path)：它覆盖 Write/NotebookEdit 等
# 所有编辑工具；Write(path) 写法不会被文件权限检查匹配。显式配置时以此处为准，不与默认值合并。
# ALLOWED_TOOLS=Read,Grep,Glob,WebSearch,WebFetch,Edit(./memory/**),Edit(./skills/**),Edit(./schedules/**),Edit(./outbox/**)
# 可选：飞书官方 lark-cli（用户 OAuth 身份，审批/日历/任务/OKR…）。精确等于 true 才开；
# 只给 owner 加一条 Bash(lark-cli:*)，拼接命令与其他 Bash 仍被拒。先 npx @larksuite/cli@latest install 并登录。
# LARK_CLI=true
# CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MS=3600000        # 绝对上限（60 分钟）
CLAUDE_IDLE_TIMEOUT_MS=600000    # 静默多久判定卡死（10 分钟，有输出即续命）
# CLAUDE_MAX_RETRIES=2           # 网络类失败重试次数，0=关闭
# DIAG_MODEL=                    # 定时任务失败自诊断用的模型，默认 haiku

# ============ 调度与记忆 ============
# SCHED_MAX_LATE_MS=7200000      # 迟到超过该值就跳过不补跑（默认 2 小时）
# SCHED_MAX_CONCURRENT=2         # 定时任务并发上限
# CONTEXT_NUDGE_TOKENS=850000    # 上下文超过该值提醒固化记忆；0=关闭
# MEMORY_RECALL_MAX=3            # 每条消息最多召回几条相关记忆
# INCOMING_TTL_MS=1209600000     # 附件保留时长（默认 14 天）

# ============ 其他 ============
# WS_PING_TIMEOUT_SEC=30         # 长连接心跳看门狗
# PROGRESS_MIN_INTERVAL_MS=3000  # 进度卡片最小更新间隔
# STARTUP_NOTICE=                # 设 false 关闭「桥接已启动」通知
# LAUNCHD_LABEL=                 # npm run install-service 的 launchd label，默认 com.<用户名>.feishu-claude-bridge
# FEISHU_TOOLS=                  # 设 false 关闭飞书文档/多维表格工具（仅 owner）
# FFMPEG_BIN=                    # 语音转写用；建议填绝对路径
# TTS_VOICE=Tingting             # /voice 语音回复音色（macOS say）
