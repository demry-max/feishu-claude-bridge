# feishu-claude-bridge 配置。复制为 .env 后填写（npm run setup 会自动生成并设权限 600）。
# 只有「一、必填」必须填；其余留空或保持注释即用默认值。改完重启服务生效。
# .env 已被 .gitignore 忽略：不要提交，不要贴进聊天。

# ════════════════════════════ 一、必填 ════════════════════════════
# npm run register 扫码后自动写入；已有应用则从开发者后台「凭证与基础信息」复制
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# owner 的 open_id。扫码注册时自动写入；已有应用时用 npm run setup -- --set-owner ou_… 写入。
# 强烈建议设置：即使 data/owner.json 丢失/损坏，你也不会被降级成访客，更不会被别人抢走 owner 身份。
OWNER_OPEN_ID=

# ════════════════════════════ 二、常用 ════════════════════════════
# ---- 平台 ----
# 国际版 Lark（larksuite.com）填 lark；留空 = 飞书
# FEISHU_DOMAIN=

# ---- 访问控制（留空 = 不限制）----
ALLOW_USERS=            # 可使用机器人的 open_id，逗号分隔。注意：这不代表可以当 owner
ALLOW_CHATS=            # 群白名单 chat_id，逗号分隔

# ---- 模型 ----
CLAUDE_MODEL=           # 聊天/规划模型。留空 = CLI 默认；可填 fable / fable5 / opus / sonnet / haiku 或完整模型名
                        # fable 指向 claude-fable-5-1，需要 CLI >= 2.1.251（旧 CLI 用 fable5）
CLAUDE_EFFORT=          # low / medium / high / xhigh / max，留空 = CLI 默认
# 模型分工：执行用便宜/快的模型，聊天规划用旗舰。留空 = 不分工。
# 触发执行车道：消息以 /do /exec /run 开头，或句首是「执行」「去做」「动手」「go」「do it」等
# （EXEC_TRIGGERS 可整体覆盖，逗号分隔）。定时任务默认走执行车道。/model exec <模型|off> 可随时改。
# CLAUDE_EXEC_MODEL=sonnet
# CLAUDE_EXEC_EFFORT=            # 执行车道思考档，留空沿用 CLAUDE_EFFORT
# EXEC_TRIGGERS=

# ---- 可选：飞书官方 lark-cli（用户 OAuth 身份：审批 / 日历 / 任务 / OKR…）----
# 精确等于 true 才开；只给 owner 加一条 Bash(lark-cli:*)，拼接命令与其他 Bash 仍被拒。
# 先 npx @larksuite/cli@latest install 并以 owner 身份登录。
# LARK_CLI=true

# ---- 其他常用 ----
# FEISHU_TOOLS=                  # 设 false 关闭内置的飞书文档 / 多维表格 / 电子表格工具（仅 owner 可用）
# FFMPEG_BIN=                    # 语音兜底转写用；常驻服务不读 shell 的 PATH，建议填绝对路径
# TTS_VOICE=Tingting             # /voice 语音回复音色（macOS say）
# TTS_MAX_CHARS=500              # 语音回复最多朗读的字数
# STARTUP_NOTICE=                # 设 false 关闭「桥接已启动」私信
# OWNER_NAME=                    # 桥接怎么称呼 owner（消息、给模型的提示词、日志）。≤20 字，字母 / 数字，中间可夹单个空格 · . ' -；
#                                # 留空 = 对你说话用「你」、向模型描述用「owner」；不合法按留空处理并告警
# LAUNCHD_LABEL=                 # npm run install-service 的 launchd label，默认 com.<用户名>.feishu-claude-bridge
# SHUTDOWN_GRACE_SEC=120         # 优雅退出最多等几秒（0–3600，0 = 不等）。
#                                # macOS launchd 最多只等 60 秒：install-service 写 ExitTimeOut = min(它, 50) + 10，
#                                # 大于 50 时服务里按 50 秒等（钉在 plist 里）；改了之后重跑 npm run install-service

# ════════════════════ 三、可选功能（默认全部关闭）════════════════════
# ---- 桥接心跳与交办台账 ----
# 精确等于 true 才启动；每拍先由脚本读 workspace/tasks/ 台账，有到期项才调一次模型；无事不发消息。
# 运行时 owner 私聊 /heartbeat on|off|status。提示词约定见 docs/heartbeat-prompt-proposal.md（可选）。
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MIN=30
# 每日最多调模型次数（按本地日期计，重启不清零）
HEARTBEAT_MAX_RUNS_PER_DAY=12
HEARTBEAT_MODEL=claude-sonnet-5-5
HEARTBEAT_EFFORT=low
# 免打扰时段（本地时间，可跨午夜）：期间不发消息只记状态，结束后合并成一条；none 关闭
HEARTBEAT_QUIET_HOURS=22-08

# ---- 心跳：外部增量（需要本机 lark-cli 以 owner 身份登录）----
# chat_reply,approval 的子集，默认 none；calendar 未实现
HEARTBEAT_WATCH=none
# 每拍最多替几条台账拉增量，按到期顺序取（1–50）
HEARTBEAT_WATCH_MAX=10
# lark-cli 可执行文件路径，留空用 PATH 里的 lark-cli
# LARK_CLI_BIN=

# ---- 心跳：owner 对心跳消息的操作 ----
# true：只涉及一条台账的心跳消息带［知道了］［推迟一天］［不做了］（开发者后台「回调配置」用长连接接收 card.action.trigger）
HEARTBEAT_BUTTONS=false
# true：引用回复心跳消息、正文恰好是 知道了 / 推迟一天 / 不做了 之一时，桥接直接回写，不调模型
HEARTBEAT_REPLY_SHORTCUTS=false
# N>0：最近 N 条心跳消息都超过 24 小时未读就暂停发送；已读任一条或 /heartbeat on 恢复（需订阅已读事件）
HEARTBEAT_UNREAD_PAUSE=0

# ---- 心跳：验收、升级阶梯与每晚日结 ----
# 验收：off / rule（脚本规则核对）/ rule+model（核对不了的再问一次 VERIFY_MODEL）；不认识的值按 off
HEARTBEAT_VERIFY=off
# rule+model 审核用的模型（零工具的审核档）
VERIFY_MODEL=claude-haiku-5-5
# 每日最多审核次数（0–200，按本地日期，与心跳次数分开计）
VERIFY_MAX_PER_DAY=10
# 精确等于 true 时开启升级阶梯：越过 escalate_after 后按固定模板逐级提醒，不调模型
HEARTBEAT_ESCALATE_LADDER=false
# 最多升几级（1–10）；到顶后只在日结里列为「卡住」
ESCALATE_MAX=2
# 每晚台账日结的时间 HH:MM（本地时间，如 21:30）；留空 = 关；写错或落在免打扰时段里按关
HEARTBEAT_DIGEST_AT=

# ---- owner 工具档 ----
# legacy（默认，与早期版本一致）| audit（不加载用户级配置、只记录不拦截、每日汇总）| strict（按 src/tool-policy.js 执行，定时任务只读）
# 先用 audit 跑一段、看审计再切 strict。strict 下 ALLOWED_TOOLS 与 LARK_CLI 不起作用；非法值按 legacy；启动时读一次，改了要重启
OWNER_TOOL_PROFILE=legacy
# audit/strict 下从 ~/.claude/skills/ 拷进工作区 .claude/skills/ 的 lark-* 技能（逗号分隔，须匹配 ^lark-[a-z-]{1,40}$，软链跳过）
# OWNER_EXTRA_SKILLS=lark-shared,lark-im,lark-approval,lark-calendar,lark-mail,lark-doc,lark-sheets,lark-drive,lark-contact,lark-whiteboard
# OWNER_STRICT_DENY_WRITE_DIRS=        # strict 档额外拒写的目录（你在别处的代码仓库等），逗号分隔的绝对路径，默认空；
#                                # 不能是 /、家目录、桥接目录或它们的上级，不能与工作区重叠
# audit/strict 下工具审计日报私信 owner 的时间（HH:MM，本地时区）；不设默认 21:30，设为空关闭
# TOOL_AUDIT_SUMMARY_AT=21:30

# ---- owner 私聊忙时连续发消息 ----
# true=owner 私聊忙时排队合并（精确等于 true 才开；队列只在内存里，重启不保留）
OWNER_MESSAGE_QUEUE=false

# ---- 每日新会话（只作用于 owner 私聊；默认关闭）----
# off（照旧）/ shadow（只记原话、只打「该切 / 推迟」日志，不换会话、不交接）/ on（真换）；不认识的值按 off
# DAILY_SESSION=off
# 换新时刻（本地时间）：这个时刻之后的第一条 owner 私聊消息换新会话
# DAILY_SESSION_AT=04:00
# 预交接时刻；留空 = 不预交接（只带原话）；必须早于 DAILY_SESSION_AT，否则按留空
# DAILY_SESSION_HANDOFF_AT=03:30
# 新会话带上一会话最后几轮原话（0–30）
# DAILY_SESSION_ROUNDS=10
# 旧会话保留几天可以 /session back（1–28）
# DAILY_SESSION_KEEP_DAYS=14

# ---- 业务系统只读查询（bms / ias）----
# 1=owner 私聊、心跳、结果发往 owner 私聊的定时任务可只读查询业务系统（精确等于 1 才开；仅 macOS；Key 放钥匙串，见 npm run -s biz-check）
BMS_TOOL_ENABLED=0

# ---- 备用 Claude 账号（主用额度用完 / 登录失效时自动切换）----
# 备用账号用的 claude 可执行文件（例如一个导出备用账号令牌后 exec claude "$@" 的包装脚本）。留空 = 不启用，行为不变。
# 两个 claude 最好共用同一个 CLI 配置目录，换账号后 --resume 还是同一个会话；不共用时会开新会话。
# CLAUDE_FALLBACK_BIN=
# 切到备用后多少分钟再试主用（1–720，默认 30；写错按 30 处理）
# CLAUDE_FALLBACK_COOLDOWN_MIN=30

# ══════════════ 四、高级（除非清楚后果，否则保持默认）══════════════
# ---- owner 身份 ----
# owner 记录缺失时是否允许「首个私聊者自动认领」。默认关闭——
# 盘故障或误删后，下一个私聊机器人的人会继承你的全部权限。
# 优先用 npm run setup -- --set-owner；真要临时设为 true，登记完立刻删掉（npm run doctor 会对它报提醒）。
# ALLOW_OWNER_CLAIM=

# ---- claude CLI ----
# 注意：写在本文件里的键都不会交给 claude 子进程（登录令牌 CLAUDE_CODE_OAUTH_TOKEN 等放行项除外）；要给 claude 用的代理等变量请设在服务自己的环境里，并且不要同时写在本文件里。
# CLAUDE_BIN=claude              # 常驻服务找不到 claude 时填绝对路径
# 常驻服务不继承终端登录态时可用长期令牌：本人运行 claude setup-token，把输出填在这里（不要交给别人代填）
# CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TIMEOUT_MS=3600000        # 绝对上限（60 分钟）
CLAUDE_IDLE_TIMEOUT_MS=600000    # 静默多久判定卡死（10 分钟，有输出即续命）
# CLAUDE_RESULT_GRACE_MS=10000    # 结果已到、进程不退时再等多久就结束整组并按结果收尾（毫秒，100–120000）
# CLAUDE_MAX_RETRIES=2           # 网络类失败重试次数，0 = 关闭
# DIAG_MODEL=                    # 定时任务失败自诊断用的模型，默认 claude-haiku-5-5

# ---- 工具白名单 ----
# owner 可用的内置工具（下面即默认值）。写权限规则必须用 Edit(path)：它覆盖 Write/NotebookEdit 等
# 所有编辑工具；Write(path) 写法不会被文件权限检查匹配。显式配置时以此处为准，不与默认值合并。
# 不要往里加 Bash。
# ALLOWED_TOOLS=Read,Grep,Glob,WebSearch,WebFetch,Edit(./memory/**),Edit(./skills/**),Edit(./schedules/**),Edit(./outbox/**),Edit(./tasks/**)
# 非 owner 会话的 --allowedTools（默认只给 WebSearch）。不要往里加 Bash 或文件工具。
# NON_OWNER_TOOLS=WebSearch
# 访客（非 owner）可用的内置工具白名单（--tools）。默认只给 WebSearch。
# 加 WebFetch 意味着访客可请求任意 URL，包括 127.0.0.1 与内网地址
# （可用于探测本机端口，也可把数据编码进 URL 外传）。
# GUEST_TOOLS=WebSearch
# 访客的显式拒绝清单（--disallowedTools，双保险）。默认值很长，见 src/claude.js 的 GUEST_DENIED_TOOLS；
# 只能加、不建议改短。无论怎么配，Bash/Edit/Write/SendMessage/Artifact 等高危工具对访客永远不可用（代码内硬下限）
# GUEST_DENIED_TOOLS=

# ---- 目录 ----
# WORKSPACE_DIR=                 # owner 工作区，默认 ./workspace
# GUEST_WORKSPACE_DIR=           # 访客工作区，默认 ./workspace-guest；必须与 owner 工作区分离
# DATA_DIR=                      # 会话、owner、心跳状态、审计日志，默认 ./data

# ---- 调度与记忆 ----
# SCHED_MAX_LATE_MS=7200000      # 迟到超过该值就跳过不补跑（默认 2 小时）
# SCHED_MAX_CONCURRENT=2         # 定时任务并发上限
# SCHED_APPROVAL_MODE=command    # 发往别处的定时任务怎么确认：command（文字命令，缺省）| button（卡片按钮）
# CONTEXT_NUDGE_TOKENS=850000    # 上下文超过该值提醒固化记忆；0 = 关闭
# MEMORY_RECALL_MAX=3            # 每条消息最多召回几条相关记忆
# INCOMING_TTL_MS=1209600000     # 附件保留时长（默认 14 天）

# ---- 连接与显示 ----
# WS_PING_TIMEOUT_SEC=30         # 长连接心跳看门狗（秒）
# PROGRESS_MIN_INTERVAL_MS=3000  # 进度卡片最小更新间隔
